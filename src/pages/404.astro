---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" noindex>
  <section class="container-page py-32 text-center">
    <p class="font-mono text-sm text-accent-strong">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Esta página no existe.</h1>
    <p class="mt-4 text-muted">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a href="/" class="btn-primary mt-8">Volver al inicio</a>
  </section>
</Base>
