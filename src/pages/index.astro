---
import Base from '../layouts/Base.astro';
import ProductWindow from '../components/ProductWindow.astro';
import Pipeline from '../components/Pipeline.astro';
import PanelBento from '../components/PanelBento.astro';
import { site } from '../site';

const steps = [
  {
    title: 'Crea tu cuenta y carga tu catálogo',
    text: 'Describe tu negocio y agrega tus productos o servicios con sus precios. Si algo es “a cotizar”, también se puede.',
  },
  {
    title: 'Conecta tu WhatsApp',
    text: 'Vincula el número de tu negocio desde el panel con el registro oficial de Meta. Sin instalar nada.',
  },
  {
    title: 'Vently atiende y vende',
    text: 'Responde al instante, resuelve dudas, toma los datos del pedido y lo deja listo en tu panel.',
  },
];

const faqs = [
  {
    q: '¿Necesito saber programar o armar un chatbot?',
    a: 'No. Vently no es un constructor de flujos. Solo describes tu negocio y cargas tu catálogo; la inteligencia artificial se encarga de conversar.',
  },
  {
    q: '¿Usa la API oficial de WhatsApp?',
    a: 'Sí. Vently funciona sobre WhatsApp Business Platform, la plataforma oficial de Meta para empresas. Conectas tu número mediante el registro integrado de Meta, desde el panel.',
  },
  {
    q: '¿Qué pasa si un cliente pregunta algo que la IA no sabe?',
    a: 'No inventa la respuesta. Le dice al cliente que una persona del equipo lo atenderá y te avisa en el panel para que continúes la conversación.',
  },
  {
    q: '¿Puedo responder yo en lugar de la IA?',
    a: 'Sí, en cualquier momento. Desde la bandeja de conversaciones puedes escribirle al cliente directamente y cerrar la conversación cuando termines.',
  },
  {
    q: '¿Qué pasa con los datos de mis clientes?',
    a: 'Se usan solo para atender a tus clientes en tu nombre. No los vendemos ni los compartimos con fines publicitarios. Los detalles están en nuestra política de privacidad.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Estamos en acceso anticipado: puedes crear tu cuenta sin costo. Anunciaremos los planes con anticipación, antes de realizar cualquier cobro.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    url: site.url,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: site.description,
    inLanguage: 'es',
    publisher: { '@type': 'Organization', name: site.company.legalName },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 [background-image:radial-gradient(var(--color-line)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_70%)]"
      aria-hidden="true"
    ></div>
    <div class="container-page pt-16 pb-20 sm:pt-24 lg:pt-28">
      <div class="mx-auto max-w-4xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Acceso anticipado · WhatsApp Business oficial
        </p>
        <h1 class="mt-6 text-[2.6rem] leading-[1.1] font-semibold tracking-tight text-balance sm:text-6xl">
          Tu vendedor con IA en WhatsApp.
          <span class="block text-muted">No inventa precios. Sabe cuándo pedirte ayuda.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-muted">
          Vently atiende a tus clientes al instante, responde con la información real de tu negocio y deja cada
          orden lista en tu panel. Sin armar bots. Sin perder ventas mientras no miras el celular.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={site.registerUrl} class="btn-primary px-6 py-3 text-[15px]">
            Crear cuenta gratis
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a href="#como-funciona" class="btn-ghost px-6 py-3 text-[15px]">Ver cómo funciona</a>
        </div>
      </div>
      <div class="mt-16 sm:mt-20">
        <ProductWindow />
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section>
    <div class="container-page grid gap-10 pt-8 pb-20 sm:grid-cols-3">
      <div>
        <p class="text-3xl font-semibold tracking-tight">24/7</p>
        <p class="mt-2 text-sm text-muted">Responde de día, de noche y los domingos, en segundos.</p>
      </div>
      <div>
        <p class="text-3xl font-semibold tracking-tight">Solo tus precios</p>
        <p class="mt-2 text-sm text-muted">Cotiza con los precios de tu catálogo, tal como los escribiste.</p>
      </div>
      <div>
        <p class="text-3xl font-semibold tracking-tight">1 bandeja</p>
        <p class="mt-2 text-sm text-muted">Conversaciones y órdenes en un solo lugar, para ti y tu equipo.</p>
      </div>
    </div>
  </section>

  <Pipeline />

  <PanelBento />

  <!-- Setup -->
  <section id="empezar" class="border-y border-line bg-surface">
    <div class="container-page py-24 sm:py-32">
      <div class="max-w-2xl">
        <p class="eyebrow">Para empezar</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Listo para vender en una tarde.
        </h2>
      </div>
      <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="bg-canvas p-8">
            <span class="font-mono text-sm text-accent-strong">0{i + 1}</span>
            <h3 class="mt-6 text-lg font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-7 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Comparison -->
  <section>
    <div class="container-page py-24 sm:py-32">
      <div class="max-w-2xl">
        <p class="eyebrow">La diferencia</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          No programes un bot. Suma un vendedor.
        </h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-line p-8">
          <h3 class="font-semibold text-muted">Chatbot de flujos</h3>
          <ul class="mt-6 space-y-4 text-[15px] text-muted">
            <li class="flex gap-3"><span aria-hidden="true">—</span>Tienes que diseñar cada pregunta y cada botón.</li>
            <li class="flex gap-3"><span aria-hidden="true">—</span>Si el cliente escribe algo distinto, se pierde.</li>
            <li class="flex gap-3"><span aria-hidden="true">—</span>Cada producto nuevo es un flujo nuevo que mantener.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-ink bg-ink p-8 text-canvas">
          <h3 class="font-semibold">Vently</h3>
          <ul class="mt-6 space-y-4 text-[15px]">
            <li class="flex gap-3"><span class="text-accent-on-ink" aria-hidden="true">✓</span>Describes tu negocio una vez y listo.</li>
            <li class="flex gap-3"><span class="text-accent-on-ink" aria-hidden="true">✓</span>Entiende lo que el cliente escribe, como lo escriba.</li>
            <li class="flex gap-3"><span class="text-accent-on-ink" aria-hidden="true">✓</span>Actualizas tu catálogo y la IA lo usa al momento.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="preguntas" class="border-t border-line">
    <div class="container-page grid gap-12 py-24 sm:py-32 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Lo que nos suelen preguntar.</h2>
        <p class="mt-4 text-muted">
          ¿Otra duda? Escríbenos a{' '}
          <a class="text-ink underline decoration-line underline-offset-4 hover:decoration-accent" href={`mailto:${site.company.email}`}>{site.company.email}</a>.
        </p>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid size-6 shrink-0 place-items-center rounded-full border border-line text-muted group-open:rotate-45 motion-safe:transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 pe-10 text-[15px] leading-7 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page pb-24">
    <div class="relative overflow-hidden rounded-[2rem] bg-ink px-6 py-16 text-center text-canvas sm:px-16 sm:py-20">
      <div class="absolute -top-24 left-1/2 -z-0 size-96 -translate-x-1/2 rounded-full bg-accent/30 blur-3xl" aria-hidden="true"></div>
      <h2 class="relative text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Deja que Vently atienda el próximo mensaje.
      </h2>
      <p class="relative mx-auto mt-4 max-w-lg text-canvas/70">
        Crea tu cuenta, carga tu catálogo y conecta tu WhatsApp. Tus clientes no vuelven a esperar.
      </p>
      <a href={site.registerUrl} class="btn relative mt-8 bg-canvas px-6 py-3 text-[15px] text-ink hover:bg-accent-strong hover:text-on-accent">
        Crear cuenta gratis
      </a>
    </div>
  </section>
</Base>
