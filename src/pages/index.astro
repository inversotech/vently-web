---
import Base from '../layouts/Base.astro';
import DemoChat from '../components/DemoChat.astro';
import Pipeline from '../components/Pipeline.astro';
import PanelBento from '../components/PanelBento.astro';
import Features from '../components/Features.astro';
import { site } from '../site';

const industries = ['Clínicas y centros médicos', 'Institutos y academias', 'Inmobiliarias', 'Tiendas con equipo', 'Pedidos por encargo'];

const pains = [
  {
    title: 'El chat que nadie contestó porque cada uno pensó que lo veía otro',
    text: 'Varios números, varias personas y ningún responsable claro. El cliente escribe dos veces y se va.',
  },
  {
    title: 'La cita o el pedido que quedó en el aire',
    text: 'Horarios, precios y datos repartidos en veinte mensajes. Basta uno sin leer para perder la venta o la agenda.',
  },
  {
    title: 'La pregunta de las 11\u00a0p.\u00a0m. que nadie respondió',
    text: 'Fuera de horario, en hora punta o un domingo: si el cliente espera mucho, se va a otro lado.',
  },
];

const differences = [
  {
    alone: 'Cada persona responde desde su celular, sin saber quién ya atendió a quién.',
    vently: 'Una bandeja para todo el equipo: cada chat tiene un responsable y se reparte por turnos.',
  },
  {
    alone: 'Un número por línea y nadie ve el conjunto, o todo mezclado en un solo número.',
    vently: 'Varios números especialistas en un panel. Cada persona ve solo los suyos y el dueño ve todo.',
  },
  {
    alone: 'Respuestas automáticas que no cierran nada, o una IA genérica que inventa.',
    vently: 'La IA responde con tu información, agenda en horarios libres y toma pedidos. Lo que no sabe, se lo pasa a una persona.',
  },
  {
    alone: 'La agenda y los pedidos viven en una libreta o en una hoja de cálculo.',
    vently: 'Citas y pedidos quedan registrados solos, con recordatorio, adelanto y saldo.',
  },
  {
    alone: 'Para volver a escribirles a tus clientes, copias números uno por uno.',
    vently: 'Campañas con plantillas aprobadas a quienes elijas por etiqueta o etapa del embudo.',
  },
];

const steps = [
  {
    title: 'Vemos tu operación',
    text: 'En una llamada revisamos tus números, tu equipo y cómo atiendes hoy, y si Vently te sirve.',
  },
  {
    title: 'Lo configuramos contigo',
    text: 'Servicios, precios, horarios, respuestas típicas de tu rubro y quién atiende cada número. Pruebas el asistente como si fueras tu cliente antes de activarlo.',
  },
  {
    title: 'Vently atiende y ordena',
    text: 'Conectamos tus números con la plataforma oficial de Meta y tu equipo empieza a trabajar desde un solo panel.',
  },
];

const founderIncludes = [
  'Asistente con IA en tu número de WhatsApp',
  'Pedidos con fecha de entrega, adelanto y saldo',
  'Agenda de citas y recordatorios',
  'Avisos en tu celular cuando un cliente te necesita',
  'Puesta en marcha acompañada, sin costo',
];

const teamIncludes = [
  'Varios números especialistas y equipo por número',
  'Bandeja compartida con asignación por turnos',
  'Embudo, contactos y etiquetas',
  'Campañas y plantillas de WhatsApp',
  'Flujos con botones y agenda con IA',
  'Puesta en marcha por línea, con tu equipo',
];

const faqs = [
  {
    q: '¿Sirve para mi rubro?',
    a: 'Vently es una sola plataforma para negocios que venden o atienden por WhatsApp: clínicas y centros médicos, institutos, inmobiliarias, tiendas y negocios que trabajan por encargo. Lo propio de cada rubro, como las preguntas típicas, las etapas del embudo o las reglas de la IA, viene configurado para empezar.',
  },
  {
    q: '¿Puedo tener varios números y que cada uno venda algo distinto?',
    a: 'Sí. Cada número puede vender todo tu catálogo o especializarse en algunos productos o servicios. Si un cliente pregunta por algo de otra línea, la IA le pasa el número correcto.',
  },
  {
    q: '¿Cada persona de mi equipo ve todo?',
    a: 'No. Los dueños ven todo; cada persona del equipo ve solo las conversaciones, pedidos y citas de los números que le asignes. Los chats se pueden asignar a mano o repartir por turnos.',
  },
  {
    q: '¿La IA da diagnósticos o inventa respuestas?',
    a: 'No. Responde solo con la información que tú cargaste y, cuando no sabe algo, se lo pasa a una persona con el motivo. En salud tiene reglas firmes: nunca diagnostica ni indica medicamentos, y ante una urgencia indica acudir a emergencia.',
  },
  {
    q: '¿Puedo enviar campañas o recordatorios?',
    a: 'Sí, con plantillas aprobadas por Meta, a quienes elijas por etiqueta o etapa del embudo, ahora o programadas. Quien responde “BAJA” deja de recibirlas. Meta cobra cada mensaje de campaña directo a tu cuenta, y Vently te muestra cuánto llevas.',
  },
  {
    q: '¿Usa la API oficial de WhatsApp?',
    a: 'Sí. Vently funciona sobre WhatsApp Business Platform, la plataforma oficial de Meta para empresas. Tus números se conectan con el registro integrado de Meta.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: `Para un negocio con un número, los primeros ${site.founder.seats} pagan S/ ${site.founder.price} al mes, para siempre. Para equipos con varios números armamos un plan según tus números y personas. En ambos casos, los mensajes que Meta cobra por WhatsApp se pagan aparte, directo a Meta, y Vently te muestra el consumo del mes.`,
  },
  {
    q: '¿Qué pasa con los datos de mis clientes?',
    a: 'Se usan solo para atender a tus clientes en tu nombre. No los vendemos, no los compartimos con fines publicitarios y tus conversaciones no se usan para entrenar modelos de IA. Puedes enviar un aviso de privacidad automático a cada persona nueva.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    url: site.url,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: site.description,
    inLanguage: 'es',
    offers: { '@type': 'Offer', price: String(site.founder.price), priceCurrency: 'PEN', description: 'Precio fundador mensual para un negocio con un número' },
    publisher: { '@type': 'Organization', name: site.company.legalName },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const arrow = '<svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>';
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 [background-image:radial-gradient(var(--color-line)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_70%)]"
      aria-hidden="true"
    ></div>
    <div class="container-page grid items-center gap-12 pt-12 pb-20 sm:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:gap-16 lg:pt-20 lg:pb-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Para negocios que venden y atienden por WhatsApp
        </p>
        <h1 class="mt-6 text-[2.5rem] leading-[1.1] font-semibold tracking-tight text-balance sm:text-6xl">
          Tu WhatsApp atendido con IA, y ordenado para todo tu equipo.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
          Vently responde con tu información real, agenda citas, toma pedidos y le pasa cada chat a la persona correcta.
          Varios números, un solo panel.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={site.contactUrl} class="btn-primary px-6 py-3 text-[15px]" rel="noopener">
            {site.contactLabel}
            <Fragment set:html={arrow} />
          </a>
          <a href="#funciones" class="btn-ghost px-6 py-3 text-[15px]">Ver funciones</a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
          <li class="flex items-center gap-1.5"><span class="text-success-ink" aria-hidden="true">✓</span>WhatsApp Business oficial</li>
          <li class="flex items-center gap-1.5"><span class="text-success-ink" aria-hidden="true">✓</span>Varios números y equipo</li>
          <li class="flex items-center gap-1.5"><span class="text-success-ink" aria-hidden="true">✓</span>Sin programar</li>
        </ul>
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Rubros">
          {industries.map((r) => <li class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">{r}</li>)}
        </ul>
      </div>
      <div>
        <p class="mb-3 text-center text-sm font-medium text-muted lg:text-start">
          <span aria-hidden="true">👇</span> Pruébalo como si fueras el cliente
        </p>
        <DemoChat />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="border-y border-line bg-surface">
    <div class="container-page py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow">El problema</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Los clientes ya te escriben. Lo difícil es que nadie se pierda.
        </h2>
        <p class="mt-4 text-lg leading-8 text-muted">
          Con varios números, varias personas y cientos de chats al día, el problema ya no es responder: es saber quién
          atiende qué, agendar sin errores y volver a escribirle a quien ya te compró.
        </p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-3">
        {pains.map((p, i) => (
          <li class:list={['flex flex-col rounded-3xl border p-6', i === 2 ? 'border-ink bg-ink text-canvas' : 'border-line bg-canvas']}>
            <h3 class="text-lg font-semibold tracking-tight text-balance">{p.title}</h3>
            <p class:list={['mt-2 text-sm leading-6', i === 2 ? 'text-canvas/75' : 'text-muted']}>{p.text}</p>
            {i === 2 && (
              <p class="mt-auto pt-6 text-xs text-canvas/75">
                Responder en la primera hora da casi 7 veces más probabilidades de concretar la venta.{' '}
                <a class="underline decoration-canvas/40 underline-offset-4 hover:decoration-accent" href="https://scholarsarchive.byu.edu/facpub/9711" rel="noopener">Harvard Business Review, 2011</a>
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Pipeline />

  <!-- Difference -->
  <section>
    <div class="container-page py-24 sm:py-32">
      <div class="max-w-2xl">
        <p class="eyebrow">La diferencia</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Contestar ya no basta. Lo que te falta es orden.
        </h2>
        <p class="mt-4 text-lg leading-8 text-muted">
          La IA de Meta ya conversa gratis. Vently se encarga de lo que viene después: la cita, el pedido, el responsable
          de cada chat y el seguimiento.
        </p>
      </div>
      <div class="mt-14 overflow-hidden rounded-3xl border border-line">
        <div class="hidden grid-cols-2 border-b border-line bg-surface text-sm font-semibold md:grid">
          <p class="px-6 py-4 text-muted">Solo con la app de WhatsApp</p>
          <p class="border-s border-line px-6 py-4">Con Vently</p>
        </div>
        <ul class="divide-y divide-line">
          {differences.map((d) => (
            <li class="grid md:grid-cols-2">
              <p class="flex gap-3 px-6 py-5 text-[15px] leading-7 text-muted">
                <span class="sr-only md:hidden">Solo con la app de WhatsApp: </span><span aria-hidden="true">—</span>{d.alone}
              </p>
              <p class="flex gap-3 bg-accent-soft/40 px-6 py-5 text-[15px] leading-7 md:border-s md:border-line">
                <span class="sr-only md:hidden">Con Vently: </span><span class="text-success-ink" aria-hidden="true">✓</span>{d.vently}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Features />

  <PanelBento />

  <!-- Pricing -->
  <section id="precios" class="border-y border-line bg-surface">
    <div class="container-page py-24 sm:py-32">
      <div class="max-w-2xl">
        <p class="eyebrow">Precios</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          A precio peruano, desde un número hasta todo tu equipo.
        </h2>
        <p class="mt-4 text-lg leading-8 text-muted">
          Los mensajes que Meta cobra por WhatsApp se pagan aparte, directo a Meta, y Vently te muestra el consumo de cada mes.
        </p>
      </div>
      <div class="mt-14 grid gap-4 lg:grid-cols-2">
        <div id="fundadores" class="flex flex-col rounded-3xl border border-line bg-canvas p-8 sm:p-10">
          <p class="text-sm font-semibold">Un negocio, un número</p>
          <p class="mt-4 flex items-baseline gap-2">
            <span class="text-5xl font-semibold tracking-tight tabular-nums">S/&nbsp;{site.founder.price}</span>
            <span class="text-muted">al mes</span>
          </p>
          <p class="mt-2 text-sm text-muted">Precio fundador para los primeros {site.founder.seats}, para siempre, a cambio de una conversación al mes sobre qué mejorar.</p>
          <ul class="mt-8 space-y-3 text-[15px]">
            {founderIncludes.map((item) => (
              <li class="flex gap-3"><span class="text-success-ink" aria-hidden="true">✓</span>{item}</li>
            ))}
          </ul>
          <div class="mt-auto pt-10">
            <a href={site.contactUrl} class="btn-ghost w-full justify-center px-6 py-3 text-[15px]" rel="noopener">Reservar mi cupo</a>
          </div>
        </div>
        <div class="flex flex-col rounded-3xl border border-ink bg-ink p-8 text-canvas sm:p-10">
          <p class="text-sm font-semibold">Equipos con varios números</p>
          <p class="mt-4 flex items-baseline gap-2">
            <span class="text-5xl font-semibold tracking-tight">A tu medida</span>
          </p>
          <p class="mt-2 text-sm text-canvas/70">Según tus números y tu equipo. Te lo cotizamos después de ver tu operación.</p>
          <ul class="mt-8 space-y-3 text-[15px]">
            {teamIncludes.map((item) => (
              <li class="flex gap-3"><span class="text-accent-on-ink" aria-hidden="true">✓</span>{item}</li>
            ))}
          </ul>
          <div class="mt-auto pt-10">
            <a href={site.contactUrl} class="btn w-full justify-center bg-canvas px-6 py-3 text-[15px] text-ink hover:bg-accent-strong hover:text-on-accent" rel="noopener">Agenda una demo</a>
          </div>
        </div>
      </div>
      <p class="mt-6 text-sm leading-6 text-muted">
        Meta está terminando de aprobar la conexión de números de otros negocios. Mientras tanto configuramos tu asistente
        y lo pruebas; el primer cobro llega cuando tus números estén conectados.
      </p>
    </div>
  </section>

  <!-- Setup -->
  <section id="empezar">
    <div class="container-page py-24 sm:py-32">
      <div class="max-w-2xl">
        <p class="eyebrow">Para empezar</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Te acompañamos hasta que tu equipo trabaje solo.
        </h2>
      </div>
      <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="bg-canvas p-8">
            <span class="font-mono text-sm text-accent-strong">0{i + 1}</span>
            <h3 class="mt-6 text-lg font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-7 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-muted">
        ¿Prefieres probar por tu cuenta?
        <a class="text-ink underline decoration-line underline-offset-4 hover:decoration-accent" href={site.registerUrl}>Crea una cuenta y prueba el asistente gratis</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="preguntas" class="border-t border-line">
    <div class="container-page grid gap-12 py-24 sm:py-32 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Lo que nos suelen preguntar.</h2>
        <p class="mt-4 text-muted">
          ¿Otra duda? <a class="text-ink underline decoration-line underline-offset-4 hover:decoration-accent" href={site.contactUrl} rel="noopener">Escríbenos</a>.
        </p>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid size-6 shrink-0 place-items-center rounded-full border border-line text-muted group-open:rotate-45 motion-safe:transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 pe-10 text-[15px] leading-7 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page pb-24">
    <div class="relative overflow-hidden rounded-[2rem] bg-ink px-6 py-16 text-center text-canvas sm:px-16 sm:py-20">
      <div class="absolute -top-24 left-1/2 -z-0 size-96 -translate-x-1/2 rounded-full bg-accent/30 blur-3xl" aria-hidden="true"></div>
      <h2 class="relative text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Que ningún cliente se quede sin respuesta.
      </h2>
      <p class="relative mx-auto mt-4 max-w-lg text-canvas/70">
        Escríbenos y vemos juntos tus números, tu equipo y si Vently le sirve a tu negocio.
      </p>
      <a href={site.contactUrl} class="btn relative mt-8 bg-canvas px-6 py-3 text-[15px] text-ink hover:bg-accent-strong hover:text-on-accent" rel="noopener">
        {site.contactLabel}
      </a>
    </div>
  </section>
</Base>
