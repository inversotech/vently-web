---
import Base from './Base.astro';
import { site } from '../site';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="container-page max-w-3xl py-20 sm:py-28">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-4 text-sm text-muted">Última actualización: {site.legalUpdated}</p>
    <div class="prose-legal mt-10">
      <slot />
    </div>
  </article>
</Base>
