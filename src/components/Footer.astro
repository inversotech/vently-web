---
import Logo from './Logo.astro';
import { site } from '../site';
const year = new Date().getFullYear();
---
<footer class="border-t border-line">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-4 text-sm leading-6 text-muted">
        Vendedor con inteligencia artificial para WhatsApp. Hecho en Perú para negocios de Latinoamérica.
      </p>
    </div>
    <div>
      <h2 class="text-sm font-semibold">Producto</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        <li><a class="hover:text-ink" href="/#como-funciona">Cómo funciona</a></li>
        <li><a class="hover:text-ink" href="/#panel">Panel</a></li>
        <li><a class="hover:text-ink" href={site.registerUrl}>Crear cuenta</a></li>
        <li><a class="hover:text-ink" href={site.loginUrl}>Iniciar sesión</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold">Legal</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        <li><a class="hover:text-ink" href="/privacidad">Política de privacidad</a></li>
        <li><a class="hover:text-ink" href="/terminos">Términos y condiciones</a></li>
        <li><a class="hover:text-ink" href="/eliminacion-de-datos">Eliminación de datos</a></li>
        <li><a class="hover:text-ink" href={`mailto:${site.company.email}`}>{site.company.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="container-page flex flex-col gap-2 border-t border-line py-6 text-xs text-muted sm:flex-row sm:justify-between">
    <p>© {year} {site.company.legalName} · RUC&nbsp;{site.company.ruc} · {site.company.country}</p>
    <p>WhatsApp es una marca de Meta Platforms, Inc. Vently no está afiliado a Meta.</p>
  </div>
</footer>
