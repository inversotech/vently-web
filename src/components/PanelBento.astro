---
import Chip from './Chip.astro';
import ProductWindow from './ProductWindow.astro';

const orders = [
  { customer: 'Rosa Quispe', product: 'Torta de chocolate', total: '85.00', status: 'Pendiente', paid: false, action: 'Confirmar' },
  { customer: 'Carlos Mendoza', product: 'Cheesecake de maracuyá', total: '65.00', status: 'Confirmada', paid: false, action: 'Marcar pagado' },
  { customer: 'Ana Flores', product: 'Alfajores ×12', total: '24.00', status: 'Confirmada', paid: true, action: '' },
];

const catalog = [
  { name: 'Torta de chocolate (15 personas)', price: 'S/ 85.00' },
  { name: 'Cheesecake de maracuyá', price: 'S/ 65.00' },
  { name: 'Torta personalizada', price: 'A cotizar según diseño' },
];

const stats = [
  { label: 'Conversaciones hoy', value: '38' },
  { label: 'Órdenes hoy', value: '12' },
  { label: 'Órdenes pendientes', value: '3' },
];
---
<section id="panel">
  <div class="container-page py-24 sm:py-32">
    <div class="max-w-2xl">
      <p class="eyebrow">Tu panel</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Todo lo que vende tu WhatsApp, en un solo lugar.
      </h2>
      <p class="mt-4 text-lg leading-8 text-muted">
        Revisa órdenes, responde cuando la IA te lo pide y actualiza tu catálogo, desde la computadora o el celular.
      </p>
    </div>

    <div class="reveal mt-14">
      <ProductWindow animate={false} />
    </div>

    <div class="mt-16 grid gap-4 lg:grid-cols-6">
      <!-- Orders -->
      <article class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6 lg:col-span-4">
        <h3 class="font-semibold tracking-tight">Órdenes que se crean solas</h3>
        <p class="mt-1 text-sm leading-6 text-muted">Cada venta cerrada llega con sus datos. Confírmala y marca el pago con un clic.</p>
        <div class="mt-6 overflow-hidden rounded-2xl border border-line" aria-hidden="true">
          <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] gap-x-4 border-b border-line bg-canvas px-4 py-2 text-[11px] font-medium text-muted sm:grid-cols-[minmax(0,1fr)_auto_auto_7rem]">
            <span>Cliente</span><span class="text-end">Total</span><span>Estado</span><span class="hidden sm:block">Acciones</span>
          </div>
          {orders.map((o) => (
            <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-x-4 border-b border-line px-4 py-3 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_auto_auto_7rem]">
              <span class="min-w-0">
                <span class="block truncate text-[13px] font-medium">{o.customer}</span>
                <span class="block truncate text-[12px] text-muted">{o.product}</span>
              </span>
              <span class="text-end text-[13px] font-semibold tabular-nums">S/&nbsp;{o.total}</span>
              <span class="flex flex-col items-start gap-1">
                <Chip tone={o.status === 'Pendiente' ? 'attention' : 'success'}>{o.status}</Chip>
                <Chip tone={o.paid ? 'success' : 'neutral'}>{o.paid ? 'Pagada' : 'Sin pago'}</Chip>
              </span>
              <span class="hidden sm:block">
                {o.action && <span class="block rounded-lg border border-line px-2.5 py-1.5 text-center text-[12px] font-medium">{o.action}</span>}
              </span>
            </div>
          ))}
        </div>
      </article>

      <!-- Stats -->
      <article class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6 lg:col-span-2">
        <h3 class="font-semibold tracking-tight">Tu día de un vistazo</h3>
        <p class="mt-1 text-sm leading-6 text-muted">Sabes cuánto vendiste sin abrir el chat.</p>
        <dl class="mt-6 grid flex-1 content-end gap-3" aria-hidden="true">
          {stats.map((s) => (
            <div class="flex items-baseline justify-between rounded-2xl bg-canvas px-4 py-3">
              <dt class="text-[13px] text-muted">{s.label}</dt>
              <dd class="text-2xl font-semibold tracking-tight tabular-nums">{s.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-[11px] text-muted">Datos de ejemplo.</p>
      </article>

      <!-- Handoff -->
      <article class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6 lg:col-span-3">
        <h3 class="font-semibold tracking-tight">Te avisa cuando te necesita</h3>
        <p class="mt-1 text-sm leading-6 text-muted">Si la respuesta no está en tu información, la IA no improvisa: te pasa la conversación.</p>
        <div class="mt-6 space-y-3 rounded-2xl border border-line bg-canvas p-4" aria-hidden="true">
          <div class="flex gap-2.5 rounded-xl bg-attention-soft p-3 text-attention-ink">
            <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
            <span>
              <span class="block text-[13px] font-semibold">El asistente te derivó esta conversación</span>
              <span class="block text-[12px]">Lucía Torres · hace 2 min</span>
            </span>
          </div>
          <p class="w-fit max-w-[90%] rounded-2xl rounded-es-md bg-bubble-in px-3 py-2 text-[12px] leading-snug">
            ¿Pueden escribir “Feliz cumple, mamá” en la torta?
          </p>
          <div class="flex items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2 text-[12px] text-muted">
            <span class="flex-1">Escribe tu respuesta…</span>
            <span class="rounded-md bg-ink px-2.5 py-1 font-medium text-canvas">Enviar</span>
          </div>
        </div>
      </article>

      <!-- Catalog -->
      <article class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6 lg:col-span-3">
        <h3 class="font-semibold tracking-tight">Tu catálogo manda</h3>
        <p class="mt-1 text-sm leading-6 text-muted">Lo que cargas es lo único que la IA ofrece. Si algo se cotiza aparte, lo dice tal cual.</p>
        <ul class="mt-6 divide-y divide-line rounded-2xl border border-line bg-canvas" aria-hidden="true">
          {catalog.map((p) => (
            <li class="flex items-center justify-between gap-4 px-4 py-3">
              <span class="min-w-0 truncate text-[13px] font-medium">{p.name}</span>
              <span class:list={['shrink-0 text-[13px] tabular-nums', p.price.startsWith('S/') ? 'font-semibold' : 'text-muted']}>{p.price}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>
