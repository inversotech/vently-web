---
import Chip from './Chip.astro';

interface Props { animate?: boolean }
const { animate = true } = Astro.props;
const seq = animate ? 'seq' : '';

type Stage = 'greeting' | 'collecting' | 'confirming' | 'completed' | 'human';
const stage: Record<Stage, { label: string; tone: 'neutral' | 'info' | 'attention' | 'success' }> = {
  greeting: { label: 'Saludo', tone: 'neutral' },
  collecting: { label: 'Recabando datos', tone: 'info' },
  confirming: { label: 'Confirmando', tone: 'attention' },
  completed: { label: 'Completado', tone: 'success' },
  human: { label: 'Te necesita', tone: 'attention' },
};

const conversations: { name: string; preview: string; stage: Stage; time: string; active?: boolean }[] = [
  { name: 'Rosa Quispe', preview: 'Sí, confirmo 🙌', stage: 'completed', time: '10:04', active: true },
  { name: 'Lucía Torres', preview: '¿Pueden escribir un mensaje en la torta?', stage: 'human', time: '09:52' },
  { name: 'Carlos Mendoza', preview: '¿Tienen cheesecake de maracuyá?', stage: 'collecting', time: '09:41' },
  { name: 'Jorge Ramos', preview: 'Hola, buenas tardes', stage: 'greeting', time: '09:30' },
];

// Delays (ms) keep the whole sequence under 5s.
const messages: { from: 'in' | 'out'; text: string; time: string; d: number }[] = [
  { from: 'in', text: 'Hola, ¿cuánto cuesta la torta de chocolate para 15 personas?', time: '10:01', d: 300 },
  { from: 'out', text: '¡Hola! La torta de chocolate para 15 personas cuesta S/ 85. ¿Para qué día la necesitas?', time: '10:01', d: 900 },
  { from: 'in', text: 'Para el sábado. A nombre de Rosa Quispe, a Av. Primavera 1450, Surco.', time: '10:03', d: 1600 },
  { from: 'out', text: 'Perfecto, Rosa: 1 torta de chocolate (15 personas), S/ 85, entrega el sábado en Av. Primavera 1450. ¿Confirmamos?', time: '10:03', d: 2300 },
  { from: 'in', text: 'Sí, confirmo 🙌', time: '10:04', d: 3000 },
];
const orderDelay = 3600;
---
<figure
  class="relative mx-auto w-full max-w-5xl"
  role="img"
  aria-label="Panel de Vently: la IA responde a una clienta por WhatsApp con el precio del catálogo, recoge sus datos y crea la orden número 128 lista para confirmar."
>
  <div class="absolute -inset-x-10 -top-10 bottom-0 -z-10 rounded-[3rem] bg-accent/15 blur-3xl" aria-hidden="true"></div>

  <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_40px_100px_-40px_rgb(0_0_0/0.45)] sm:rounded-3xl">
    <!-- Window chrome -->
    <div class="flex items-center gap-3 border-b border-line bg-canvas px-4 py-3">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
      </span>
      <span class="mx-auto truncate rounded-md bg-surface px-3 py-1 text-[11px] text-muted ring-1 ring-line">app.vently.lat/conversaciones</span>
      <span class="w-10" aria-hidden="true"></span>
    </div>

    <div class="grid md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)_minmax(0,17rem)]">
      <!-- Inbox -->
      <aside class="hidden border-e border-line md:block">
        <p class="px-4 pt-4 pb-2 text-xs font-semibold">Conversaciones</p>
        <ul class="px-2 pb-3">
          {conversations.map((c) => (
            <li class:list={['rounded-xl px-2.5 py-2.5', c.active && 'bg-canvas ring-1 ring-line']}>
              <div class="flex items-center gap-2">
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-accent-soft text-[11px] font-semibold text-success-ink">{c.name[0]}</span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-center justify-between gap-2">
                    <span class="truncate text-[13px] font-medium">{c.name}</span>
                    <span class="text-[11px] text-muted tabular-nums">{c.time}</span>
                  </span>
                  <span class="block truncate text-[12px] text-muted">{c.preview}</span>
                </span>
              </div>
              <div class="mt-1.5 ps-9"><Chip tone={stage[c.stage].tone}>{stage[c.stage].label}</Chip></div>
            </li>
          ))}
        </ul>
      </aside>

      <!-- Chat -->
      <section class="flex min-w-0 flex-col">
        <div class="flex items-center gap-3 border-b border-line px-4 py-3">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent-soft text-xs font-semibold text-success-ink">R</span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold">Rosa Quispe</span>
            <span class="block text-[11px] text-muted">WhatsApp · atendida por la IA</span>
          </span>
          <span class="grid">
            {animate && <Chip tone="info" class="seq-out col-start-1 row-start-1 justify-self-end" style={`--d:${orderDelay}ms`}>Recabando datos</Chip>}
            <Chip tone="success" class={`${seq} col-start-1 row-start-1 justify-self-end`} style={`--d:${orderDelay}ms`}>Completado</Chip>
          </span>
        </div>

        <ol class="flex-1 space-y-2.5 px-4 py-4 text-[13px] leading-snug">
          {messages.map((m) => (
            <li class:list={[seq, 'flex', m.from === 'out' ? 'justify-end' : 'justify-start']} style={`--d:${m.d}ms`}>
              <p class:list={[
                'max-w-[85%] rounded-2xl px-3.5 py-2',
                m.from === 'out' ? 'rounded-ee-md bg-bubble-out' : 'rounded-es-md bg-bubble-in',
              ]}>
                {m.text}
                <span class="mt-0.5 block text-end text-[11px] text-muted tabular-nums">
                  {m.time}{m.from === 'out' && <span class="ms-1 text-success-ink">✓✓</span>}
                </span>
              </p>
            </li>
          ))}
        </ol>

        <!-- Order card, inline on smaller screens -->
        <div class:list={[seq, 'px-4 pb-4 lg:hidden']} style={`--d:${orderDelay}ms`}>
          <div class="rounded-xl border border-line bg-canvas p-3.5">
            <div class="flex items-center justify-between">
              <span class="text-[13px] font-semibold">Orden #128</span>
              <Chip tone="attention">Pendiente</Chip>
            </div>
            <p class="mt-1.5 text-[12px] text-muted">Torta de chocolate (15 personas) · <span class="font-semibold text-ink tabular-nums">S/&nbsp;85.00</span></p>
          </div>
        </div>
      </section>

      <!-- Order panel -->
      <aside class="hidden border-s border-line bg-canvas/60 p-4 lg:block">
        <p class="text-xs font-semibold">Orden creada por la IA</p>
        <div class:list={[seq, 'mt-3 rounded-xl border border-line bg-surface p-4 shadow-sm']} style={`--d:${orderDelay}ms`}>
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold">Orden #128</span>
            <Chip tone="attention">Pendiente</Chip>
          </div>
          <dl class="mt-3 space-y-2 text-[12px]">
            <div class="flex justify-between gap-3"><dt class="text-muted">Cliente</dt><dd class="font-medium">Rosa Quispe</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-muted">Producto</dt><dd class="text-end font-medium">Torta de chocolate</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-muted">Cantidad</dt><dd class="font-medium tabular-nums">1</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-muted">Dirección</dt><dd class="text-end font-medium">Av. Primavera 1450, Surco</dd></div>
            <div class="flex justify-between gap-3 border-t border-line pt-2"><dt class="text-muted">Total</dt><dd class="font-semibold tabular-nums">S/&nbsp;85.00</dd></div>
          </dl>
          <span class="mt-4 block rounded-lg bg-ink px-3 py-2 text-center text-[12px] font-semibold text-canvas">Confirmar orden</span>
        </div>
        <p class:list={[seq, 'mt-3 flex items-center gap-1.5 text-[11px] text-muted']} style={`--d:${orderDelay + 300}ms`}>
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Precio tomado de tu catálogo
        </p>
      </aside>
    </div>
  </div>
</figure>
