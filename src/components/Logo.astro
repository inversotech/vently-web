---
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2 font-semibold tracking-tight', className]}>
  {/* Same marks as app.vently.lat: green tile on light, black tile on dark. */}
  <picture>
    <source srcset="/brand/logo-negro.webp" media="(prefers-color-scheme: dark)" />
    <img src="/brand/logo-verde.webp" alt="" width="64" height="64" decoding="async" class="size-7" />
  </picture>
  <span class="text-lg">Vently</span>
</span>
